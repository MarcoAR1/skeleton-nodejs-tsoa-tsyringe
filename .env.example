# ── Server ─────────────────────────────────────────────
PORT=8080
# Selects which .env.<NODE_ENV> file is loaded (local | development | staging | production)
NODE_ENV=local

# ── MongoDB ────────────────────────────────────────────
# Optional. Leave empty to boot WITHOUT a database connection.
MONGO_URI=mongodb://localhost:27017/skeleton

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-in-production

{
  "name": "skeleton-nodejs-tsoa-tsyringe",
  "version": "2.0.0",
  "description": "Node.js + TypeScript backend skeleton (DDD + TSOA + TSyringe + MongoDB)",
  "private": true,
  "scripts": {
    "start": "node ./dist/src/infrastructure/start",
    "build": "tsoa spec-and-routes && tsc && npm run copy:env",
    "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
    "tsoa:routes": "tsoa spec-and-routes",
    "pretest": "tsoa routes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "copy:env": "cp .env.local dist/ 2>/dev/null || true",
    "lint": "eslint --fix --ext .ts .",
    "lint:check": "eslint --ext .ts ."
  },
  "dependencies": {
    "axios": "1.13.2",
    "body-parser": "2.2.1",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-http-context": "2.0.1",
    "helmet": "8.1.0",
    "http-status": "2.1.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "^9.1.1",
    "morgan": "1.10.1",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "tsyringe": "^4.10.0",
    "uuid": "^8.3.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
